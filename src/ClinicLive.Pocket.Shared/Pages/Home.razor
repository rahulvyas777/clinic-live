@page "/"
@inject NavigationManager Nav
@inject ICodeScanner Scanner
@inject IHaptics Haptics

<PageTitle>ClinicLive Pocket</PageTitle>

<section class="hero">
    <h1>Your visit, in your pocket.</h1>
    <p class="lead">
        Check in from the car park, watch the queue move, and get a nudge when it's
        your turn — no more staring at the wall TV.
    </p>
</section>

<section class="card">
    <h2>Find my appointment</h2>
    <p class="muted">Your confirmation code is on your booking ticket.</p>

    <form class="stack" @onsubmit="Go" @onsubmit:preventDefault>
        <label class="visually-hidden" for="code">Confirmation code</label>
        <input id="code" class="code-input" @bind="_code" @bind:event="oninput"
               placeholder="••••••" maxlength="6" autocomplete="off" autocapitalize="characters"
               spellcheck="false" inputmode="text" />
        <button class="btn btn-primary btn-lg" type="submit" disabled="@(_code.Trim().Length < 6)">
            Show my visit
        </button>
    </form>

    @if (Scanner.IsSupported)
    {
        <p class="muted small" style="text-align:center; margin: var(--s-3) 0 var(--s-2)">or</p>
        <button class="btn btn-ghost" type="button" @onclick="ScanAsync" disabled="@_scanning">
            @(_scanning ? "Opening the camera…" : "📷 Scan my ticket")
        </button>
        @if (_scanMessage is not null)
        {
            <p class="muted small" style="margin-top: var(--s-2)">@_scanMessage</p>
        }
    }
</section>

@code {
    private string _code = "";
    private bool _scanning;
    private string? _scanMessage;

    private void Go() => Nav.NavigateTo($"visit/{_code.Trim().ToUpperInvariant()}");

    private async Task ScanAsync()
    {
        _scanning = true;
        _scanMessage = null;
        try
        {
            var raw = await Scanner.ScanAsync();
            if (raw is null)
            {
                _scanMessage = "No scan — you can type the code instead.";
            }
            else if (TicketCode.TryParse(raw, out var code))
            {
                Haptics.Tap();
                Nav.NavigateTo($"visit/{code}");
            }
            else
            {
                _scanMessage = "That QR isn't a ClinicLive ticket.";
            }
        }
        finally
        {
            _scanning = false;
        }
    }
}
