@page "/"
@inject NavigationManager Nav
@inject ICodeScanner Scanner
@inject IHaptics Haptics
@inject VisitMemory Memory

<PageTitle>ClinicLive Pocket</PageTitle>

<section class="hero">
    <h1>Your visit, in your pocket.</h1>
    <p class="lead">
        Check in from the car park, watch the queue move, and get a nudge when it's
        your turn — no more staring at the wall TV.
    </p>
</section>

@if (_remembered is not null)
{
    <section class="card">
        <h2>Welcome back</h2>
        <p class="muted">Your visit is still on this phone.</p>
        <a class="btn btn-primary btn-lg" href="visit/@_remembered">Continue with <span class="mono">@_remembered</span></a>
    </section>
}

<section class="card">
    <h2>@(_remembered is null ? "Find my appointment" : "A different appointment?")</h2>
    <p class="muted">Your confirmation code is on your booking ticket.</p>

    <form class="stack" @onsubmit="Go" @onsubmit:preventDefault>
        <label class="visually-hidden" for="code">Confirmation code</label>
        <input id="code" class="code-input" @bind="_code" @bind:event="oninput"
               placeholder="••••••" maxlength="6" autocomplete="off" autocapitalize="characters"
               spellcheck="false" inputmode="text" />
        <button class="btn @(_remembered is null ? "btn-primary btn-lg" : "btn-ghost")" type="submit" disabled="@(_code.Trim().Length < 6)">
            Show my visit
        </button>
    </form>

    @if (Scanner.IsSupported)
    {
        <p class="muted small" style="text-align:center; margin: var(--s-3) 0 var(--s-2)">or</p>
        <button class="btn btn-ghost" type="button" @onclick="ScanAsync" disabled="@_scanning">
            @(_scanning ? "Opening the camera…" : "📷 Scan my ticket")
        </button>
        @if (_scanMessage is not null)
        {
            <p class="muted small" style="margin-top: var(--s-2)">@_scanMessage</p>
        }
    }
</section>

@* Season four, Part 9. Not a tab: the five tabs are the five things a patient came here to
   do, and asking a question is something you do once, on the way. A card on Home is where
   the app already puts that kind of thing (the scan button above). *@
<section class="card">
    <h2>A question before you come in?</h2>
    <p class="muted">Opening times, what to bring, parking, how to pay — answered by the clinic itself.</p>
    <a class="btn btn-ghost" href="ask">💬 Ask the clinic</a>
</section>

@code {
    private string _code = "";
    private string? _remembered;
    private bool _scanning;
    private string? _scanMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // After render, not during: the web host's storage talks to the browser.
        if (firstRender)
        {
            _remembered = await Memory.GetCodeAsync();
            if (_remembered is not null)
            {
                StateHasChanged();
            }
        }
    }

    private void Go() => Nav.NavigateTo($"visit/{_code.Trim().ToUpperInvariant()}");

    private async Task ScanAsync()
    {
        _scanning = true;
        _scanMessage = null;
        try
        {
            var raw = await Scanner.ScanAsync();
            if (raw is null)
            {
                _scanMessage = "No scan — you can type the code instead.";
            }
            else if (TicketCode.TryParse(raw, out var code))
            {
                Haptics.Tap();
                Nav.NavigateTo($"visit/{code}");
            }
            else
            {
                _scanMessage = "That QR isn't a ClinicLive ticket.";
            }
        }
        finally
        {
            _scanning = false;
        }
    }
}
