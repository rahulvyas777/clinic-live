@page "/visit"
@page "/visit/{Code}"
@implements IDisposable
@inject PocketApi Api
@inject QueueLive Live
@inject IHaptics Haptics
@inject INotifier Notifier
@inject IPushRegistration Push
@inject IAppLifecycle Lifecycle
@inject VisitMemory Memory
@inject NavigationManager Nav

<PageTitle>My visit — ClinicLive Pocket</PageTitle>

<div class="row" style="justify-content: space-between; margin-bottom: var(--s-3)">
    <h1 style="margin: 0">My visit</h1>
    @if (_visit is not null && !_connected && !_stale)
    {
        <span class="pill pill-warn">reconnecting…</span>
    }
</div>

@if (Code is null && !_redirecting)
{
    <section class="card">
        <p class="muted">Enter your confirmation code on the Home tab to see your visit here.</p>
        <a class="btn btn-ghost" href="">Go to Home</a>
    </section>
}
else if (Code is null)
{
    <section class="card"><p class="muted">Opening your visit…</p></section>
}
else if (_loading && _visit is null)
{
    <section class="card">
        <p class="muted">Asking the clinic about <span class="mono">@Code</span>…</p>
    </section>
}
else if (_unreachable && _visit is null)
{
    <section class="card">
        <div class="notice notice-danger">Can't reach the clinic right now.</div>
        <p class="muted">Check your connection and try again.</p>
        <button class="btn btn-ghost" @onclick="LoadAsync">Try again</button>
    </section>
}
else if (_visit is null)
{
    <section class="card">
        <div class="notice">No visit found for <span class="mono">@Code</span>.</div>
        <p class="muted">Codes are six characters and never contain 0, O, 1, I or L.</p>
        <a class="btn btn-ghost" href="">Try another code</a>
    </section>
}
else
{
    @if (_stale)
    {
        <div class="notice">
            Showing what the clinic said at <strong>@_staleSince</strong> — we can't reach it right now.
        </div>
    }

    <section class="card">
        <div class="row" style="justify-content: space-between">
            <h2 style="margin:0">Hi @_visit.FirstName</h2>
            <span class="pill @StatusPillClass(_visit.Status)">@StatusLabel(_visit.Status)</span>
        </div>
        <p class="lead" style="margin-top: var(--s-3)">
            <strong>@_visit.DayLocal</strong> at <strong>@_visit.StartsAtLocal</strong>
        </p>

        @switch (_visit.Status)
        {
            case VisitStatus.Booked when _visit.CanCheckIn:
                <p class="muted">You're here? Check in and take a seat — we'll buzz you when you're next, and again when it's your turn.</p>
                @if (_checkInError is not null)
                {
                    <div class="notice">@_checkInError</div>
                }
                <button class="btn btn-primary btn-lg" @onclick="CheckInAsync" disabled="@(_busy || _stale)">
                    @(_busy ? "Checking in…" : "I'm here — check me in")
                </button>
                break;

            case VisitStatus.Booked:
                <p class="muted">Check-in opens on the day of your appointment.</p>
                break;

            case VisitStatus.CheckedIn:
                <p class="big-label">Your place in the queue</p>
                <p class="big-number" @key="_visit.Position">@(_visit.Position?.ToString() ?? "—")</p>
                <p class="muted">
                    @(_visit.WaitingCount == 1 ? "You're the only one waiting." : $"{_visit.WaitingCount} people waiting.")
                    @if (_visit.NowServing is not null)
                    {
                        @* the masked name ("David C.") already ends with a full stop *@
                        <text> Now serving <strong>@_visit.NowServing</strong></text>
                    }
                </p>
                @if (_pushRegistered)
                {
                    <p class="muted small">Push is on — you can close the app and we'll still reach you.</p>
                }
                else if (_notifications == false)
                {
                    <p class="muted small">Notifications are off, so keep this screen open — it still updates live.</p>
                }
                else if (Push.Platform is null)
                {
                    <p class="muted small">Keep this screen open — it updates live.</p>
                }
                break;

            case VisitStatus.InProgress:
                <div class="notice notice-ok">It's your turn — please go through.</div>
                break;

            case VisitStatus.Done:
                <p class="muted">Thanks for visiting. See you next time.</p>
                break;

            default:
                <p class="muted">This appointment is @StatusLabel(_visit.Status).ToLowerInvariant().</p>
                break;
        }
    </section>

    @if (_visit.Status is VisitStatus.Booked or VisitStatus.CheckedIn && !_stale)
    {
        <p class="muted small" style="text-align:center">
            @(_connected ? "Live — updates the moment the queue moves." : "Showing the last thing the clinic told us.")
        </p>
    }
}

@code {
    [Parameter] public string? Code { get; set; }

    private VisitDto? _visit;
    private bool _loading;
    private bool _unreachable;
    private bool _busy;
    private bool _connected;
    private bool _redirecting;
    private bool _stale;
    private string? _staleSince;
    private bool? _notifications;   // null = never asked
    private bool _pushRegistered;
    private bool _skipNextNudge;    // the push already told them while we were away
    private string? _checkInError;

    protected override async Task OnInitializedAsync()
    {
        // The hub is app-wide; this screen just listens while it's on screen.
        Live.Changed += OnQueueChanged;
        Live.ConnectionChanged += OnConnectionChanged;
        Lifecycle.Resumed += OnResumed;
        await Live.EnsureStartedAsync();
        _connected = Live.IsConnected;
    }

    protected override Task OnParametersSetAsync() => Code is null ? Task.CompletedTask : LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The tab was tapped with no code: open the remembered visit, if there is one.
        if (firstRender && Code is null)
        {
            var remembered = await Memory.GetCodeAsync();
            if (remembered is not null)
            {
                _redirecting = true;
                Nav.NavigateTo($"visit/{remembered}", replace: true);
            }
        }
    }

    private void OnQueueChanged() => _ = InvokeAsync(async () =>
    {
        if (Code is not null)
        {
            await LoadAsync();
            StateHasChanged();
        }
    });

    private void OnConnectionChanged(bool connected) => _ = InvokeAsync(() =>
    {
        _connected = connected;
        StateHasChanged();
    });

    // Coming back from the background: whatever changed while we were away, the
    // push notification (Part 6) already said it. Don't say it twice.
    private void OnResumed() => _skipNextNudge = _pushRegistered;

    // Loads are serialised. The check-in button and the hub's QueueChanged fire
    // within milliseconds of each other; two concurrent loads both captured the
    // pre-check-in state as "before" and BOTH nudged — the shade showed two
    // identical "You're next" notifications. One load at a time, in order.
    private readonly SemaphoreSlim _loadGate = new(1, 1);

    private async Task LoadAsync()
    {
        await _loadGate.WaitAsync();
        _loading = true;
        _unreachable = false;
        try
        {
            var before = _visit;
            _visit = await Api.GetVisitAsync(Code!);
            _stale = false;

            if (_visit is not null)
            {
                await Memory.RememberAsync(_visit);   // Part 9: survives a closed app and a dead signal
            }

            if (before is not null && _visit is not null)
            {
                if (_skipNextNudge)
                {
                    _skipNextNudge = false;
                }
                else if (await Memory.NudgesEnabledAsync())
                {
                    await NudgeIfItMattersAsync(before, _visit);
                }
            }

            // A phone that shows a checked-in visit should be reachable when the app
            // is closed. Idempotent on the server, so calling it on every load is fine.
            if (_visit is { Status: VisitStatus.CheckedIn } && !_pushRegistered)
            {
                await RegisterForPushAsync();
            }
        }
        catch (ClinicUnreachableException)
        {
            _unreachable = true;
            // Part 9: no signal, but maybe a memory. Only THIS visit's memory counts.
            if (_visit is null && await Memory.GetCachedAsync() is { } cached && cached.Visit.Code == Code)
            {
                _visit = cached.Visit;
                _stale = true;
                _staleSince = cached.StoredAtUtc.ToLocalTime().ToString("HH:mm");
            }
        }
        finally
        {
            _loading = false;
            _loadGate.Release();
        }
    }

    private async Task RegisterForPushAsync()
    {
        if (Push.Platform is null)
        {
            return;   // this host has no push — Windows, the browser, iOS-not-built-here
        }
        var token = await Push.GetTokenAsync();
        if (token is not null)
        {
            _pushRegistered = await Api.RegisterDeviceAsync(Code!, Push.Platform, token);
        }
    }

    /// <summary>
    /// Only TRANSITIONS earn a buzz — never the first load, never a refresh that
    /// changed nothing. Two moments matter to someone in a waiting room: "you're
    /// next" (get your things together) and "it's your turn" (go now).
    /// </summary>
    private async Task NudgeIfItMattersAsync(VisitDto before, VisitDto after)
    {
        if (after.Status == VisitStatus.InProgress && before.Status != VisitStatus.InProgress)
        {
            Haptics.Buzz();
            await Notifier.ShowAsync("It's your turn", $"{after.FirstName}, please go through now.");
        }
        else if (after.Status == VisitStatus.CheckedIn && after.Position == 1 && before.Position != 1)
        {
            Haptics.Tap();
            await Notifier.ShowAsync("You're next", "Get ready — you're first in the queue.");
        }
    }

    private async Task CheckInAsync()
    {
        _busy = true;
        _checkInError = null;
        try
        {
            // Ask for notifications HERE, where the reason is obvious — not at app launch.
            _notifications = await Notifier.RequestPermissionAsync();

            var result = await Api.CheckInAsync(Code!);
            if (result.Success)
            {
                Haptics.Tap();
            }
            else
            {
                _checkInError = result.Error;
            }
            await LoadAsync();
        }
        catch (ClinicUnreachableException)
        {
            _unreachable = true;
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        Live.Changed -= OnQueueChanged;
        Live.ConnectionChanged -= OnConnectionChanged;
        Lifecycle.Resumed -= OnResumed;
    }

    private static string StatusLabel(VisitStatus s) => s switch
    {
        VisitStatus.Booked => "Booked",
        VisitStatus.CheckedIn => "Checked in",
        VisitStatus.InProgress => "Your turn",
        VisitStatus.Done => "Done",
        VisitStatus.Cancelled => "Cancelled",
        VisitStatus.NoShow => "Missed",
        _ => s.ToString(),
    };

    private static string StatusPillClass(VisitStatus s) => s switch
    {
        VisitStatus.CheckedIn => "pill-primary",
        VisitStatus.InProgress => "pill-ok",
        VisitStatus.Cancelled or VisitStatus.NoShow => "pill-danger",
        _ => "",
    };
}
