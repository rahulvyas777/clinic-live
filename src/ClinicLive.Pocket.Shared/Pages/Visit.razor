@page "/visit"
@page "/visit/{Code}"
@implements IDisposable
@inject PocketApi Api
@inject QueueLive Live

<PageTitle>My visit — ClinicLive Pocket</PageTitle>

<div class="row" style="justify-content: space-between; margin-bottom: var(--s-3)">
    <h1 style="margin: 0">My visit</h1>
    @if (_visit is not null && !_connected)
    {
        <span class="pill pill-warn">reconnecting…</span>
    }
</div>

@if (Code is null)
{
    <section class="card">
        <p class="muted">Enter your confirmation code on the Home tab to see your visit here.</p>
        <a class="btn btn-ghost" href="">Go to Home</a>
    </section>
}
else if (_loading && _visit is null)
{
    <section class="card">
        <p class="muted">Asking the clinic about <span class="mono">@Code</span>…</p>
    </section>
}
else if (_unreachable && _visit is null)
{
    <section class="card">
        <div class="notice notice-danger">Can't reach the clinic right now.</div>
        <p class="muted">Check your connection and try again.</p>
        <button class="btn btn-ghost" @onclick="LoadAsync">Try again</button>
    </section>
}
else if (_visit is null)
{
    <section class="card">
        <div class="notice">No visit found for <span class="mono">@Code</span>.</div>
        <p class="muted">Codes are six characters and never contain 0, O, 1, I or L.</p>
        <a class="btn btn-ghost" href="">Try another code</a>
    </section>
}
else
{
    <section class="card">
        <div class="row" style="justify-content: space-between">
            <h2 style="margin:0">Hi @_visit.FirstName</h2>
            <span class="pill @StatusPillClass(_visit.Status)">@StatusLabel(_visit.Status)</span>
        </div>
        <p class="lead" style="margin-top: var(--s-3)">
            <strong>@_visit.DayLocal</strong> at <strong>@_visit.StartsAtLocal</strong>
        </p>

        @switch (_visit.Status)
        {
            case VisitStatus.Booked when _visit.CanCheckIn:
                <p class="muted">You're here? Check in and take a seat — this screen will tell you when it's your turn.</p>
                @if (_checkInError is not null)
                {
                    <div class="notice">@_checkInError</div>
                }
                <button class="btn btn-primary btn-lg" @onclick="CheckInAsync" disabled="@_busy">
                    @(_busy ? "Checking in…" : "I'm here — check me in")
                </button>
                break;

            case VisitStatus.Booked:
                <p class="muted">Check-in opens on the day of your appointment.</p>
                break;

            case VisitStatus.CheckedIn:
                <p class="big-label">Your place in the queue</p>
                <p class="big-number" @key="_visit.Position">@(_visit.Position?.ToString() ?? "—")</p>
                <p class="muted">
                    @(_visit.WaitingCount == 1 ? "You're the only one waiting." : $"{_visit.WaitingCount} people waiting.")
                    @if (_visit.NowServing is not null)
                    {
                        @* the masked name ("David C.") already ends with a full stop *@
                        <text> Now serving <strong>@_visit.NowServing</strong></text>
                    }
                </p>
                break;

            case VisitStatus.InProgress:
                <div class="notice notice-ok">It's your turn — please go through.</div>
                break;

            case VisitStatus.Done:
                <p class="muted">Thanks for visiting. See you next time.</p>
                break;

            default:
                <p class="muted">This appointment is @StatusLabel(_visit.Status).ToLowerInvariant().</p>
                break;
        }
    </section>

    @if (_visit.Status is VisitStatus.Booked or VisitStatus.CheckedIn)
    {
        <p class="muted small" style="text-align:center">
            @(_connected ? "Live — updates the moment the queue moves." : "Showing the last thing the clinic told us.")
        </p>
    }
}

@code {
    [Parameter] public string? Code { get; set; }

    private VisitDto? _visit;
    private bool _loading;
    private bool _unreachable;
    private bool _busy;
    private bool _connected;
    private string? _checkInError;

    protected override async Task OnInitializedAsync()
    {
        // The hub is app-wide; this screen just listens while it's on screen.
        Live.Changed += OnQueueChanged;
        Live.ConnectionChanged += OnConnectionChanged;
        await Live.EnsureStartedAsync();
        _connected = Live.IsConnected;
    }

    protected override Task OnParametersSetAsync() => Code is null ? Task.CompletedTask : LoadAsync();

    private void OnQueueChanged() => _ = InvokeAsync(async () =>
    {
        if (Code is not null)
        {
            await LoadAsync();
            StateHasChanged();
        }
    });

    private void OnConnectionChanged(bool connected) => _ = InvokeAsync(() =>
    {
        _connected = connected;
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        _loading = true;
        _unreachable = false;
        try
        {
            _visit = await Api.GetVisitAsync(Code!);
        }
        catch (ClinicUnreachableException)
        {
            _unreachable = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CheckInAsync()
    {
        _busy = true;
        _checkInError = null;
        try
        {
            var result = await Api.CheckInAsync(Code!);
            if (!result.Success)
            {
                _checkInError = result.Error;
            }
            await LoadAsync();
        }
        catch (ClinicUnreachableException)
        {
            _unreachable = true;
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        Live.Changed -= OnQueueChanged;
        Live.ConnectionChanged -= OnConnectionChanged;
    }

    private static string StatusLabel(VisitStatus s) => s switch
    {
        VisitStatus.Booked => "Booked",
        VisitStatus.CheckedIn => "Checked in",
        VisitStatus.InProgress => "Your turn",
        VisitStatus.Done => "Done",
        VisitStatus.Cancelled => "Cancelled",
        VisitStatus.NoShow => "Missed",
        _ => s.ToString(),
    };

    private static string StatusPillClass(VisitStatus s) => s switch
    {
        VisitStatus.CheckedIn => "pill-primary",
        VisitStatus.InProgress => "pill-ok",
        VisitStatus.Cancelled or VisitStatus.NoShow => "pill-danger",
        _ => "",
    };
}
