@page "/cancel"
@rendermode InteractiveServer
@using ClinicLive.Services
@inject BookingService Booking

<PageTitle>Cancel a booking — ClinicLive</PageTitle>

<div class="book">
    <h1>Cancel a booking</h1>
    <p class="text-muted">Type the six-character code from your ticket. That's all we need.</p>

    <div class="mb-3">
        <label class="form-label" for="code">Confirmation code</label>
        <input id="code" class="form-control form-control-lg text-uppercase font-monospace"
               maxlength="6" autocomplete="off" spellcheck="false"
               @bind="_code" @bind:event="oninput" placeholder="K7M2XQ" />
    </div>

    <button class="btn btn-danger btn-lg w-100" @onclick="CancelAsync" disabled="@(_code.Length < 6 || _busy)">
        @(_busy ? "One moment…" : "Cancel this appointment")
    </button>

    @if (_message is not null)
    {
        <div class="alert @(_ok ? "alert-success" : "alert-warning") mt-3">@_message</div>
    }
</div>

@code {
    private string _code = string.Empty;
    private string? _message;
    private bool _ok;
    private bool _busy;

    private async Task CancelAsync()
    {
        _busy = true;
        _ok = await Booking.CancelAsync(_code);
        _busy = false;
        _message = _ok
            ? "Done — your appointment is cancelled and the slot is free again. Book any time."
            : "We couldn't find an active booking with that code. Check the ticket and try again.";
        if (_ok)
        {
            _code = string.Empty;
        }
    }
}
