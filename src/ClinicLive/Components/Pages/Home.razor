@page "/"

<PageTitle>ClinicLive</PageTitle>

<h1>Welcome to ClinicLive</h1>

<p class="lead" style="max-width: 40rem;">
    Book an appointment in under a minute — no account needed. Already booked?
    Check in at the kiosk by the door and watch the waiting-room board for your name.
</p>

<div class="d-flex gap-2 mt-4">
    <a class="btn btn-primary btn-lg" href="book">Book an appointment</a>
    <a class="btn btn-outline-secondary btn-lg" href="cancel">Cancel a booking</a>
</div>
