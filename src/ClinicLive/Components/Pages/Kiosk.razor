@page "/kiosk"
@layout ClinicLive.Components.Layout.BareLayout
@rendermode InteractiveServer
@using ClinicLive.Services
@inject QueueService Queue

<PageTitle>Check in — ClinicLive</PageTitle>

<div class="text-center mt-5" style="max-width: 30rem; margin: 0 auto;">
    <h1 class="display-5">Welcome 👋</h1>
    <p class="lead">Type the code from your booking to check in.</p>

    <input class="form-control form-control-lg text-center text-uppercase font-monospace fs-1 my-4"
           maxlength="6" @bind="_code" @bind:event="oninput" placeholder="······" />

    <button class="btn btn-primary btn-lg px-5" @onclick="CheckInAsync"
            disabled="@(_code.Length < 6 || _busy)">
        Check in
    </button>

    @if (_result is not null)
    {
        @if (_result.Success)
        {
            <div class="alert alert-success mt-4 fs-4">
                You're checked in! You are <strong>number @_result.Position</strong> in the queue.
                Watch the board for your name. 🪑
            </div>
        }
        else
        {
            <div class="alert alert-warning mt-4">@_result.Error</div>
        }
    }
</div>

@code {
    private string _code = string.Empty;
    private bool _busy;
    private CheckInResult? _result;

    private async Task CheckInAsync()
    {
        _busy = true;
        _result = await Queue.CheckInAsync(_code);
        _busy = false;
        if (_result.Success)
        {
            _code = string.Empty;
        }
    }
}
