@page "/board"
@layout ClinicLive.Components.Layout.BareLayout
@rendermode InteractiveServer
@implements IAsyncDisposable
@using ClinicLive.Services
@using Microsoft.AspNetCore.SignalR.Client
@inject QueueService Queue
@inject ClinicTime Clinic
@inject NavigationManager Navigation

<PageTitle>Waiting room — ClinicLive</PageTitle>

<div class="board">
    <header class="board-top">
        <span class="board-brand">Clinic<span>Live</span></span>
        <time class="board-clock">@Clinic.Local(DateTime.UtcNow)</time>
    </header>

    <section class="board-serving">
        <p class="board-label">Now serving</p>
        @if (_snapshot?.NowServing is { } serving)
        {
            <p class="board-name" @key="serving.AppointmentId">@serving.DisplayName</p>
        }
        else
        {
            <p class="board-name board-name-idle">—</p>
        }
    </section>

    <section class="board-next">
        <p class="board-label">Up next</p>
        @if (_snapshot is null || _snapshot.Waiting.Count == 0)
        {
            <p class="board-empty">No one is waiting</p>
        }
        else
        {
            <ol class="board-list">
                @foreach (var item in _snapshot.Waiting.Take(5))
                {
                    <li @key="item.AppointmentId">@item.DisplayName</li>
                }
            </ol>
            @if (_snapshot.Waiting.Count > 5)
            {
                <p class="board-empty">+ @(_snapshot.Waiting.Count - 5) more</p>
            }
        }
    </section>

    @if (!_connected)
    {
        <div class="board-status">reconnecting…</div>
    }
</div>

@code {
    private QueueSnapshot? _snapshot;
    private HubConnection? _hub;
    private bool _connected;
    private System.Timers.Timer? _clock;

    protected override async Task OnInitializedAsync()
    {
        _snapshot = await Queue.GetSnapshotAsync();

        // a wall clock that actually ticks
        _clock = new System.Timers.Timer(TimeSpan.FromSeconds(20));
        _clock.Elapsed += (_, _) => _ = InvokeAsync(StateHasChanged);
        _clock.Start();

        _hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/queue"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On("QueueChanged", async () =>
        {
            _snapshot = await Queue.GetSnapshotAsync();
            await InvokeAsync(StateHasChanged);
        });

        _hub.Reconnected += async _ =>
        {
            await _hub.InvokeAsync(nameof(ClinicLive.Hubs.QueueHub.JoinBoard));
            _snapshot = await Queue.GetSnapshotAsync();
            _connected = true;
            await InvokeAsync(StateHasChanged);
        };
        _hub.Closed += async _ =>
        {
            _connected = false;
            await InvokeAsync(StateHasChanged);
        };
        _hub.Reconnecting += async _ =>
        {
            _connected = false;
            await InvokeAsync(StateHasChanged);
        };

        await _hub.StartAsync();
        await _hub.InvokeAsync(nameof(ClinicLive.Hubs.QueueHub.JoinBoard));
        _connected = true;
    }

    public async ValueTask DisposeAsync()
    {
        _clock?.Dispose();
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
