@page "/book"
@rendermode InteractiveServer
@using ClinicLive.Services
@inject BookingService Booking
@inject ClinicTime Clinic

<PageTitle>Book an appointment — ClinicLive</PageTitle>

<div class="book">
    <h1>Book an appointment</h1>

    @if (_confirmed is not null)
    {
        <p class="lead">You're booked, @FirstName(_confirmed.Patient.FullName). 🎉</p>

        <div class="ticket">
            <div class="ticket-when">@Clinic.Local(_confirmed.StartsAt, "dddd d MMMM · HH:mm")</div>
            <div class="ticket-code">@_confirmed.ConfirmationCode</div>
            <p class="ticket-hint">
                Your check-in code. Type it at the kiosk when you arrive —
                it's also all you need to <a href="/cancel">cancel</a>.
            </p>
        </div>

        <button class="btn btn-outline-primary" @onclick="Reset">Book another appointment</button>
    }
    else
    {
        <p class="text-muted">Pick a day and a time — no account, no password, under a minute.</p>

        <div class="mb-3">
            <label class="form-label" for="date">Day</label>
            <InputDate id="date" class="form-control" @bind-Value="_date" @bind-Value:after="LoadSlotsAsync" />
        </div>

        @if (_loading)
        {
            <p class="text-muted">Checking the calendar…</p>
        }
        else if (_slots.Count == 0)
        {
            <div class="alert">
                Nothing free on that day. Try the next one — mornings fill up first.
            </div>
        }
        else
        {
            foreach (var group in SlotGroups())
            {
                <section class="slot-section">
                    <h2>@group.Label</h2>
                    <div class="slot-grid">
                        @foreach (var slot in group.Slots)
                        {
                            <button class="slot-btn @(slot == _selected ? "selected" : "")"
                                    @onclick="() => _selected = slot">
                                @Clinic.Local(slot)
                            </button>
                        }
                    </div>
                </section>
            }
        }

        @if (_selected is not null)
        {
            <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="book">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label" for="name">Full name</label>
                    <InputText id="name" class="form-control" autocomplete="name" @bind-Value="_form.FullName" />
                    <ValidationMessage For="() => _form.FullName" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="phone">Phone</label>
                    <InputText id="phone" class="form-control" type="tel" autocomplete="tel" @bind-Value="_form.Phone" />
                    <ValidationMessage For="() => _form.Phone" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="email">Email <span class="text-muted">(optional)</span></label>
                    <InputText id="email" class="form-control" type="email" autocomplete="email" @bind-Value="_form.Email" />
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@_saving">
                    @(_saving ? "Booking…" : $"Book {Clinic.Local(_selected.Value)}")
                </button>
            </EditForm>
        }

        @if (_error is not null)
        {
            <div class="alert alert-warning mt-3">@_error</div>
        }
    }
</div>

@code {
    private DateOnly _date;
    private List<DateTime> _slots = [];
    private DateTime? _selected;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private ClinicLive.Domain.Appointment? _confirmed;
    private BookForm _form = new();

    protected override void OnInitialized() => _date = Clinic.Today;

    protected override Task OnInitializedAsync() => LoadSlotsAsync();

    private async Task LoadSlotsAsync()
    {
        _loading = true;
        _selected = null;
        _slots = await Booking.GetFreeSlotsAsync(_date);
        _loading = false;
    }

    private IEnumerable<(string Label, List<DateTime> Slots)> SlotGroups()
    {
        var morning = _slots.Where(s => int.Parse(Clinic.Local(s, "HH")) < 12).ToList();
        var afternoon = _slots.Except(morning).ToList();
        if (morning.Count > 0) yield return ("Morning", morning);
        if (afternoon.Count > 0) yield return ("Afternoon", afternoon);
    }

    private async Task SubmitAsync()
    {
        if (_selected is null)
        {
            return;
        }

        _saving = true;
        _error = null;
        var result = await Booking.BookAsync(_form.FullName!, _form.Phone!, _form.Email, _selected.Value);
        _saving = false;

        if (result.Success)
        {
            _confirmed = result.Appointment;
        }
        else
        {
            _error = result.Error;
            await LoadSlotsAsync();
        }
    }

    private async Task Reset()
    {
        _confirmed = null;
        _form = new BookForm();
        await LoadSlotsAsync();
    }

    private static string FirstName(string full) => full.Split(' ')[0];

    private sealed class BookForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "We need a name for the appointment.")]
        [System.ComponentModel.DataAnnotations.StringLength(200)]
        public string? FullName { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "We need a phone number to find your booking later.")]
        [System.ComponentModel.DataAnnotations.StringLength(30)]
        public string? Phone { get; set; }

        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "That email doesn't look right — or leave it empty.")]
        [System.ComponentModel.DataAnnotations.StringLength(200)]
        public string? Email { get; set; }
    }
}
