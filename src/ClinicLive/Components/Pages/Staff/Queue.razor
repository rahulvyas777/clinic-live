@page "/staff/queue"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = ClinicLive.Data.DbSeeder.ReceptionRole)]
@implements IAsyncDisposable
@using ClinicLive.Services
@using Microsoft.AspNetCore.SignalR.Client
@inject QueueService QueueSvc
@inject ClinicTime Clinic
@inject NavigationManager Navigation

<PageTitle>Queue — ClinicLive</PageTitle>

<header class="staff-head">
    <h1>Queue</h1>
    <p class="staff-stats">
        <span class="stat"><strong>@(_snapshot?.Waiting.Count ?? 0)</strong> waiting</span>
    </p>
</header>

<div class="row" style="max-width: 52rem;">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <p class="staff-card-label">Now serving</p>
                <p class="fs-3 fw-bold mb-0">@(_snapshot?.NowServing?.DisplayName ?? "—")</p>
            </div>
        </div>
        <button class="btn btn-primary btn-lg w-100" @onclick="CallNextAsync" disabled="@_busy">
            Call next patient
        </button>
        @if (_empty)
        {
            <p class="text-muted mt-2">The queue is empty — nice work.</p>
        }
    </div>
    <div class="col-md-6">
        @if (_snapshot is { Waiting.Count: > 0 })
        {
            <table class="table table-sm align-middle staff-table">
                <thead><tr><th>#</th><th>Patient</th><th>Slot</th><th>Waited</th></tr></thead>
                <tbody>
                    @{ var n = 0; }
                    @foreach (var item in _snapshot.Waiting)
                    {
                        n++;
                        <tr>
                            <td class="text-muted">@n</td>
                            <td class="fw-bold">@item.DisplayName</td>
                            <td class="font-monospace">@Clinic.Local(item.SlotAt)</td>
                            <td class="font-monospace @(WaitedMinutes(item) >= 20 ? "text-danger" : "text-muted")">
                                @WaitedMinutes(item) min
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No one is waiting right now.</p>
        }
    </div>
</div>

@code {
    private QueueSnapshot? _snapshot;
    private HubConnection? _hub;
    private bool _busy;
    private bool _empty;

    protected override async Task OnInitializedAsync()
    {
        _snapshot = await QueueSvc.GetSnapshotAsync();

        _hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/queue"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On("QueueChanged", async () =>
        {
            _snapshot = await QueueSvc.GetSnapshotAsync();
            await InvokeAsync(StateHasChanged);
        });

        await _hub.StartAsync();
        await _hub.InvokeAsync(nameof(ClinicLive.Hubs.QueueHub.JoinBoard));
    }

    private async Task CallNextAsync()
    {
        _busy = true;
        var called = await QueueSvc.CallNextAsync();
        _empty = !called;
        _busy = false;
    }

    private static int WaitedMinutes(QueueItem item) =>
        Math.Max(0, (int)(DateTime.UtcNow - item.CheckedInAt).TotalMinutes);

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            await _hub.DisposeAsync();
        }
    }
}
