@page "/staff/assistant"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using ClinicLive.Services.Ai
@inject AssistantService AssistantSvc
@inject ILogger<Assistant> Logger

<PageTitle>Assistant — ClinicLive</PageTitle>

<header class="staff-head">
    <h1>Assistant</h1>
</header>

<div class="card" style="max-width: 46rem;">
    <div class="card-body">
        <p class="text-muted">Answers come from the clinic's own server. Nothing leaves the building.</p>

        <div class="chat-log" role="log" aria-label="Assistant transcript">
            @foreach (var turn in _turns)
            {
                <div class="chat-msg @(turn.Mine ? "mine" : "")" @key="turn">
                    <span class="chat-meta"><strong>@(turn.Mine ? "You" : "Assistant")</strong></span>
                    <span class="chat-bubble">@turn.Text</span>
                    @if (turn.Cites.Count > 0)
                    {
                        <span class="chat-cites">
                            @foreach (var cite in turn.Cites)
                            {
                                <span class="chat-cite" title="@cite.Chunk.Preview">[@cite.Number] @cite.Chunk.Label</span>
                            }
                        </span>
                    }
                </div>
            }
            @if (_thinking)
            {
                <div class="chat-msg">
                    <span class="chat-meta">thinking…</span>
                </div>
            }
        </div>

        <div class="d-flex gap-2 mt-3">
            <input class="form-control" maxlength="500" placeholder="Ask the assistant…"
                   @bind="_draft" @bind:event="oninput" @onkeydown="OnKeyDown"
                   disabled="@_streaming" />
            <button class="btn btn-primary" @onclick="AskAsync"
                    disabled="@(_streaming || string.IsNullOrWhiteSpace(_draft))">
                Send
            </button>
        </div>
    </div>
</div>

@code {
    // One transcript per circuit. Part 5 stores nothing: close the tab, it is gone.
    private readonly List<Turn> _turns = [];
    private string _draft = string.Empty;
    private bool _streaming;
    private bool _thinking;

    private sealed class Turn
    {
        public bool Mine { get; init; }
        public string Text { get; set; } = string.Empty;

        /// <summary>The documents under the bubble. Empty for a question and for a refusal.</summary>
        public List<Citation> Cites { get; set; } = [];
    }

    /// <summary>A retrieved chunk and the number the prompt gave it, so [2] means [2].</summary>
    private sealed record Citation(int Number, RetrievedChunk Chunk);

    private async Task AskAsync()
    {
        var question = _draft.Trim();
        if (question.Length == 0 || _streaming)
        {
            return;
        }

        _draft = string.Empty;
        _streaming = true;
        _thinking = true;
        _turns.Add(new Turn { Mine = true, Text = question });

        var answer = new Turn();

        try
        {
            // Retrieval finishes before the first token, so the chunks are in hand already.
            var reply = await AssistantSvc.AskAsync(question, "staff", CancellationToken.None);
            var guarded = false;

            await foreach (var delta in reply.Deltas)
            {
                if (delta == AssistantService.GuardMarker)
                {
                    // The service found the finished answer had no citation. Whatever is on
                    // screen was never allowed to stand: replace it with the refusal.
                    guarded = true;
                    answer.Text = AssistantService.RefusalText;
                    answer.Cites = [];
                    continue;
                }

                if (_thinking)
                {
                    // First token: swap the "thinking…" line for the bubble it fills.
                    _thinking = false;
                    _turns.Add(answer);
                }

                answer.Text += delta;
                await InvokeAsync(StateHasChanged);
            }

            if (_thinking)
            {
                // The model streamed nothing at all — still owe the user a bubble.
                _thinking = false;
                answer.Text = AssistantService.RefusalText;
                _turns.Add(answer);
            }

            if (!guarded)
            {
                answer.Cites = Citations(reply.Chunks, answer.Text);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "The assistant failed to answer");
            _thinking = false;
            _turns.Remove(answer);
            _turns.Add(new Turn { Text = "The assistant is not available right now." });
        }
        finally
        {
            _streaming = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Which documents to print under the bubble: the ones the answer's "Sources:" line names.
    /// A refusal cites nothing. An answer that cited no usable number still stands on the
    /// chunks it was given — the guard let it through — so those are shown instead.
    /// </summary>
    private static List<Citation> Citations(IReadOnlyList<RetrievedChunk> chunks, string answer)
    {
        if (chunks.Count == 0 || AssistantService.IsRefusal(answer))
        {
            return [];
        }

        var cited = AssistantService.CitedNumbers(answer)
            .Where(n => n >= 1 && n <= chunks.Count)
            .Select(n => new Citation(n, chunks[n - 1]))
            .ToList();

        return cited.Count > 0
            ? cited
            : chunks.Select((c, i) => new Citation(i + 1, c)).ToList();
    }

    private Task OnKeyDown(KeyboardEventArgs e) =>
        e.Key == "Enter" ? AskAsync() : Task.CompletedTask;
}
