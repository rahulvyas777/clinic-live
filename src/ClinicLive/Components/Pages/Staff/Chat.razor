@page "/staff/chat"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@using ClinicLive.Services
@inject ChatService ChatSvc
@inject ChatRoom Room
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>Staff chat — ClinicLive</PageTitle>

<header class="staff-head">
    <h1>Staff chat</h1>
    <p class="staff-stats">
        <span class="stat"><strong>@_online.Count</strong> online</span>
    </p>
</header>

<div class="chat">
    <div class="chat-main">
        <div class="chat-log" role="log" aria-label="Messages" @ref="_log">
            @foreach (var m in _messages)
            {
                <div class="chat-msg @(m.SenderName == _me ? "mine" : "")" @key="m">
                    <span class="chat-meta">
                        <strong>@ShortName(m.SenderName)</strong>
                        <time>@m.SentAt.ToString("HH:mm")</time>
                    </span>
                    <span class="chat-bubble">@m.Body</span>
                </div>
            }
        </div>

        <p class="chat-typing" role="status">
            @if (_typingOthers.Count > 0)
            {
                @string.Join(", ", _typingOthers.Select(ShortName))
                <text> typing…</text>
            }
        </p>

        <div class="d-flex gap-2">
            <input class="form-control" maxlength="2000" placeholder="Message the team…"
                   @bind="_draft" @bind:event="oninput" @bind:after="OnTyping"
                   @onkeydown="OnKeyDown" />
            <button class="btn btn-primary" @onclick="SendAsync" disabled="@string.IsNullOrWhiteSpace(_draft)">
                Send
            </button>
        </div>
    </div>
    <aside class="chat-side">
        <p class="staff-card-label">Online</p>
        <ul class="chat-online">
            @foreach (var user in _online)
            {
                <li><span aria-hidden="true">●</span> @ShortName(user)</li>
            }
        </ul>
    </aside>
</div>

@code {
    private List<ChatMessageView> _messages = [];
    private IReadOnlyList<string> _online = [];
    private List<string> _typingOthers = [];
    private string _draft = string.Empty;
    private string _me = string.Empty;
    private string _myId = string.Empty;
    private bool _joined;

    private ElementReference _log;
    private bool _scrollPending;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _me = auth.User.Identity?.Name ?? "unknown";
        _myId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        _messages = await ChatSvc.GetRecentAsync();

        Room.MessageReceived += OnMessage;
        Room.PresenceChanged += OnPresence;
        Room.TypingChanged += OnTypingChanged;
        Room.Join(_me);
        _joined = true;

        _online = Room.OnlineUsers;
    }

    private async Task SendAsync()
    {
        var body = _draft;
        _draft = string.Empty;
        await ChatSvc.SendAsync(_myId, _me, body);
    }

    private Task OnKeyDown(KeyboardEventArgs e) =>
        e.Key == "Enter" && !string.IsNullOrWhiteSpace(_draft) ? SendAsync() : Task.CompletedTask;

    private void OnTyping() => Room.SetTyping(_me);

    private void OnMessage(ChatMessageView m) => _ = InvokeAsync(() =>
    {
        _messages.Add(m);
        if (_messages.Count > 200)
        {
            _messages.RemoveAt(0);
        }
        _scrollPending = true;
        StateHasChanged();
    });

    private void OnPresence() => _ = InvokeAsync(() =>
    {
        _online = Room.OnlineUsers;
        StateHasChanged();
    });

    private void OnTypingChanged() => _ = InvokeAsync(() =>
    {
        _typingOthers = Room.TypingUsers.Where(u => u != _me).ToList();
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _scrollPending)
        {
            _scrollPending = false;
            await JS.InvokeVoidAsync("clinic.scrollToEnd", _log);
        }
    }

    /// <summary>reception@cliniclive.test → reception</summary>
    private static string ShortName(string email) => email.Split('@')[0];

    public void Dispose()
    {
        Room.MessageReceived -= OnMessage;
        Room.PresenceChanged -= OnPresence;
        Room.TypingChanged -= OnTypingChanged;
        if (_joined)
        {
            Room.Leave(_me);
        }
    }
}
